# ============================================================
# 🔧 FUNCIÓN CLAVE: Ejecutar lupdate ANTES de traducir
# ============================================================
def ejecutar_lupdate():
"""Ejecuta lupdate para poblar los archivos .ts con los textos del código C++"""
print("\n🔍 Ejecutando lupdate para poblar archivos .ts...")
# Buscar lupdate en varias ubicaciones comunes
lupdate_paths = [
"/usr/lib/qt6/bin/lupdate",
"/usr/bin/lupdate",
"/usr/lib/qt6/bin/lupdate-qt6",
"/usr/bin/lupdate-qt6",
]
lupdate_cmd = None
for path in lupdate_paths:
if os.path.exists(path):
lupdate_cmd = path
break
if not lupdate_cmd:
# Intentar encontrarlo con which
try:
result = subprocess.run(["which", "lupdate"], capture_output=True, text=True)
if result.returncode == 0:
lupdate_cmd = result.stdout.strip()
except:
pass
if not lupdate_cmd:
print("⚠️  No se encontró lupdate. Los archivos .ts pueden estar vacíos.")
print("   Instala: sudo apt install qt6-l10n-tools")
return False
# Archivos fuente a escanear (se añade ImageFilters.h para extraer los filtros)
source_files = []
if os.path.exists("../src/main.cpp"):
source_files.append("../src/main.cpp")
if os.path.exists("../src/paintarea.h"):
source_files.append("../src/paintarea.h")
if os.path.exists("../src/ImageFilters.h"):
source_files.append("../src/ImageFilters.h")
if os.path.exists("main.cpp"):
source_files.append("main.cpp")
if os.path.exists("paintarea.h"):
source_files.append("paintarea.h")
if os.path.exists("ImageFilters.h"):
source_files.append("ImageFilters.h")
if not source_files:
print("⚠️  No se encontraron archivos fuente C++")
return False
# Archivos .ts a actualizar
ts_files = [f"paintux_{lang}.ts" for lang in ["es", "en", "fr", "de", "it", "pt", "zh", "ar", "ru", "ja", "ko", "tr", "pl", "nl", "sv", "hi"]]
cmd = [lupdate_cmd] + source_files + ["-ts"] + ts_files
print(f"   Comando: {' '.join(cmd)}")
try:
result = subprocess.run(cmd, capture_output=True, text=True)
if result.returncode == 0:
print("✅ lupdate ejecutado correctamente")
return True
else:
print(f"⚠️  lupdate devolvió código {result.returncode}")
print(f"   stderr: {result.stderr}")
return False
except Exception as e:
print(f"❌ Error ejecutando lupdate: {e}")
return False
# ============================================================
# FUNCIÓN DE TRADUCCIÓN
# ============================================================
def traducir_archivo(filename, lang_code):
"""Traduce un archivo .ts de Qt al idioma especificado."""
if not os.path.exists(filename):
print(f"✗ Archivo no encontrado: {filename}")
return False, 0, 0
try:
tree = ET.parse(filename)
root = tree.getroot()
count = 0
total = 0
for context in root.findall('context'):
for message in context.findall('message'):
source = message.find('source')
translation = message.find('translation')
if source is not None and translation is not None:
texto = source.text
total += 1
if texto and texto in TRADUCCIONES and lang_code in TRADUCCIONES[texto]:
translation.text = TRADUCCIONES[texto][lang_code]
# Quitar atributo 'type' (unfinished)
if 'type' in translation.attrib:
del translation.attrib['type']
count += 1
tree.write(filename, encoding='utf-8', xml_declaration=True)
return True, count, total
except Exception as e:
print(f"✗ Error en {filename}: {e}")
return False, 0, 0
# ============================================================
# FUNCIÓN EXTRA: Compilar .ts -> .qm con lrelease
# ============================================================
def compilar_qm():
"""Compila los archivos .ts a .qm usando lrelease (necesario en runtime)."""
print("\n🔨 Compilando archivos .ts a .qm con lrelease...")
lrelease_paths = [
"/usr/lib/qt6/bin/lrelease",
"/usr/bin/lrelease",
"/usr/lib/qt6/bin/lrelease-qt6",
"/usr/bin/lrelease-qt6",
]
lrelease_cmd = None
for path in lrelease_paths:
if os.path.exists(path):
lrelease_cmd = path
break
if not lrelease_cmd:
try:
result = subprocess.run(["which", "lrelease"], capture_output=True, text=True)
if result.returncode == 0:
lrelease_cmd = result.stdout.strip()
except:
pass
if not lrelease_cmd:
print("⚠️  No se encontró lrelease. Ejecuta manualmente: lrelease paintux_*.ts")
return False
ts_files = [f for f in os.listdir(".") if f.startswith("paintux_") and f.endswith(".ts")]
if not ts_files:
print("⚠️  No hay archivos .ts para compilar")
return False
ok = True
for ts in ts_files:
try:
result = subprocess.run([lrelease_cmd, ts], capture_output=True, text=True)
if result.returncode == 0:
print(f"✓ {ts} -> {ts.replace('.ts', '.qm')}")
else:
print(f"✗ Error compilando {ts}: {result.stderr}")
ok = False
except Exception as e:
print(f"✗ Error con {ts}: {e}")
ok = False
return ok
# ============================================================
# MAIN
# ============================================================
if __name__ == "__main__":
print("=" * 70)
print("🌍 Paint-UX - Sistema de Traducción Multiidioma (16 idiomas)")
print("=" * 70)
print(f"📚 Diccionario: {len(TRADUCCIONES)} textos únicos")
print(f"🗺️  Idiomas soportados: 16 (incluyendo español base)")
print("=" * 70)
# 🔧 PASO 1: Ejecutar lupdate para poblar los archivos .ts
ejecutar_lupdate()
print("\n📁 Aplicando traducciones del diccionario...")
print("-" * 70)
idiomas = {
"paintux_en.ts": "en",
"paintux_fr.ts": "fr",
"paintux_de.ts": "de",
"paintux_it.ts": "it",
"paintux_pt.ts": "pt",
"paintux_zh.ts": "zh",
"paintux_ar.ts": "ar",
"paintux_ru.ts": "ru",
"paintux_ja.ts": "ja",
"paintux_ko.ts": "ko",
"paintux_tr.ts": "tr",
"paintux_pl.ts": "pl",
"paintux_nl.ts": "nl",
"paintux_sv.ts": "sv",
"paintux_hi.ts": "hi",
}
exitosos = 0
fallidos = 0
for archivo, codigo in idiomas.items():
ok, traducidos, total = traducir_archivo(archivo, codigo)
if ok:
exitosos += 1
print(f"✓ {archivo}: {traducidos}/{total} textos traducidos al {codigo}")
else:
fallidos += 1
print("=" * 70)
print(f"✅ Exitosos: {exitosos}")
print(f"❌ Fallidos: {fallidos}")
print("=" * 70)
# 🔨 PASO 3: Compilar .ts -> .qm automáticamente
compilar_qm()
print("=" * 70)
print("\n🚀 AHORA compila con:")
print("   cd build && cmake .. && make -j$(nproc)")
print("=" * 70)